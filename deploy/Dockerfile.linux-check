# plan61: prove ReCast builds and replays on Linux before renting a VPS. Not a production image.
# Context = tracked + untracked-not-ignored files (see deploy/README.md §1):
#   git ls-files -z -co --exclude-standard | tar --null -T - -c | docker build -f deploy/Dockerfile.linux-check -t recast-linux-check -
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12-venv python3-dev build-essential git curl ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*
ARG NODE_VERSION=22.23.2
RUN arch=$(dpkg --print-architecture | sed 's/amd64/x64/') \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz" | tar -xJ -C /usr/local --strip-components=1
WORKDIR /app
COPY . .
RUN python3.12 -m venv backend/.venv \
    && backend/.venv/bin/python -m pip install -q -e './backend[dev,scenario-build]'
RUN backend/.venv/bin/python backend/scripts/build_scenario_engine.py \
    && test -f backend/.tools/esmini/build/EnvironmentSimulator/Libraries/esminiLib/libesminiLib.so
RUN cd frontend && npm ci --no-audit --no-fund && npm run build
CMD ["sh", "-c", "cd frontend && npm run test:server && cd ../backend && .venv/bin/python -m pytest -q -rs tests/test_scenario_esmini_check.py tests/test_scenario_imported_replay.py tests/test_scene_metrics.py"]
