{
  "name": "topeye-frontend",
  "private": true,
  "version": "0.43.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode localweb",
    "build:web": "tsc && vite build --mode web",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "web:local": "npm run build && node server/local-server.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:e2e": "node scripts/test-local-web.mjs",
    "test:access": "node scripts/test-access-web.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.64.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
